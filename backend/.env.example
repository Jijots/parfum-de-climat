APP_NAME="Parfum de Climat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/parfum-de-climat/backend/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parfum_de_climat
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache ───────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Cache ────────────────────────────────────────────────────────────────────
#   file     local dev — zero setup, no service to run
#   redis    production — survives deploys, shared across instances
# Avoid 'database': the DB is remote, so cache reads would pay the same network
# round-trip the cache exists to eliminate.
CACHE_STORE=file

# ── Redis (production only) ──────────────────────────────────────────────────
# Free tier at https://upstash.com — note the rediss:// scheme (TLS).
REDIS_CLIENT=predis
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR-ENDPOINT.upstash.io:6379

# ── External APIs ─────────────────────────────────────────────────────────────
# OpenWeatherMap — get a free key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

# PerfumAPI (Fragrantica scraper) — used ONLY by the `fragrances:import` Artisan command.
# Local:  http://localhost:9000
# Hosted: https://perfumapi-frontend.onrender.com
PERFUMAPI_BASE_URL=https://perfumapi-frontend.onrender.com
PERFUMAPI_TIMEOUT=30
PERFUMAPI_CONNECT_TIMEOUT=10

# ── Python Recommendation Engine ──────────────────────────────────────────────
# MODE: 'subprocess' (default) or 'microservice'
#   subprocess   → Python spawned per-request (no server required, simpler for dev)
#   microservice → Engine runs as FastAPI server; Laravel calls it over HTTP
ENGINE_MODE=subprocess

# Path to the Python executable.
# On Windows: 'python' works if Python is in PATH, otherwise use the full path:
# PYTHON_EXECUTABLE=C:/Users/YourName/AppData/Local/Programs/Python/Python311/python.exe
PYTHON_EXECUTABLE=python

# Absolute path to the recommendation engine script.
# Leave UNSET to use the automatic default: base_path('../engine/recommendation_engine.py')
# Only override if you move the engine/ folder.
# ENGINE_SCRIPT_PATH=

# FastAPI microservice URL (only used when ENGINE_MODE=microservice)
# Start with: python engine/recommendation_engine.py --serve
ENGINE_MICROSERVICE_URL=http://127.0.0.1:8001

# Subprocess/microservice timeout in seconds
ENGINE_TIMEOUT=30

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Shown on /privacy and /terms as the contact for data requests and account
# deletion. MUST be a mailbox someone actually reads — the policy promises a
# reply, and it falls back to MAIL_FROM_ADDRESS (a noreply@) if unset.
MAIL_SUPPORT_ADDRESS="hello@parfumdeclimat.app"
MAIL_FROM_ADDRESS="noreply@parfumdeclimat.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
